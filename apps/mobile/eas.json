{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "gradleCommand": ":app:assembleDebug" },
      "env": { "EXPO_PUBLIC_API_URL": "http://SEU_IP_LOCAL:3000" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://SUBSTITUA_PELA_URL_DA_API_STAGING" }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_API_URL": "https://SUBSTITUA_PELA_URL_DA_API_PRODUCAO" }
    }
  },
  "submit": {
    "production": {}
  }
}
